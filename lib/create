#!/usr/bin/bash

. $rute/lib/checks
. $rute/lib/sums

function create_tar() {
  is_archive? "${archive}"
  case $? in 
    "0")
      . $rute/lib/append

      append_tar
      ;;
    *)
      is_file? "${archive}" && ( mv -v "${archive}" "${archive}.old" )

      tmp_path=`compress-sum "$path/$leaf" "$WRK" | awk '{print $NF}' | sed "s/'//g"`
      tmp_leaf=`echo $tmp_path | awk -F'/' '{print $NF}' | sed "s/'//g"`

      tar cJf "${archive}" -C "${tmp_path%/$tmp_leaf}" "$tmp_leaf"
      reply -i "Created ${archive} from $leaf"
      ;;
  esac
}
