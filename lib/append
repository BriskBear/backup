#!/usr/bin/bash

. $here/lib/checks
. $here/lib/reply
. $here/lib/sums

function append_tar() {
  existing="${BAK_DIR:-$path}/${archive}"
  working="$WRK/${archive%.txz}.tar"

  tmp_path=`compress-sum "$path/$leaf" "$WRK" | awk '{print $NF}' | sed "s/'//g"`
  tmp_leaf=`echo $tmp_path | awk -F'/' '{print $NF}' | sed "s/'//g"`

  xz -dc "$existing" > "$working"
  tar -rf "$working" -C "${tmp_path%/$tmp_leaf}" "$tmp_leaf"
  xz -ez9c "$working" > "$existing"

  reply -i "Added $tmp_leaf to $existing"
}
